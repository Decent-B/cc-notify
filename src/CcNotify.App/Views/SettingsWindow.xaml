<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CcNotify.Ui.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="20" MaxWidth="560">

            <StackPanel Spacing="2">
                <TextBlock Text="Claude Code Notifier" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="AutostartSwitch" Header="Start with Windows"
                              OnContent="On — starts in the tray at sign-in" OffContent="Off"
                              Toggled="OnAutostartToggled" />
                <InfoBar x:Name="AutostartBlockedBar" IsOpen="False" IsClosable="False" Severity="Warning"
                         Title="Turned off in Windows"
                         Message="Windows Settings › Apps › Startup has this app switched off, so Windows will not start it. Only you can turn it back on there.">
                    <InfoBar.ActionButton>
                        <Button Content="Open Windows startup settings" Click="OnOpenStartupSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ToggleSwitch x:Name="SoundSwitch" Header="Play a sound" Toggled="OnSoundToggled" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Notify me when" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <CheckBox x:Name="StopBox" Content="Claude finishes a task" Click="OnEventToggled" />
                <CheckBox x:Name="PermissionBox" Content="Claude needs permission" Click="OnEventToggled" />
                <CheckBox x:Name="IdleBox" Content="Claude is waiting for input" Click="OnEventToggled" />
                <CheckBox x:Name="FailureBox" Content="Claude hits an error" Click="OnEventToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Notification display" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Windows' own toasts always appear on the primary display, so cc-notify draws its own popups and can put them where you are working." />
                <ComboBox x:Name="DisplayBox" Header="Show notifications on" HorizontalAlignment="Stretch"
                          SelectionChanged="OnDisplayChanged" />
                <Button Content="Send test notification" Click="OnTestNotification" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Maintenance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HooksButton" Content="Set up Claude Code hooks" Click="OnSetupHooks" />
                    <Button x:Name="UpdateButton" Content="Check for updates" Click="OnCheckUpdates" />
                    <Button x:Name="InstallButton" Content="Install update" Visibility="Collapsed"
                            Style="{ThemeResource AccentButtonStyle}" Click="OnInstallUpdate" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton Content="Open GitHub" NavigateUri="https://github.com/Decent-B/cc-notify" Padding="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
