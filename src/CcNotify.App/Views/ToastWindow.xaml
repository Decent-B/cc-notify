<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CcNotify.Ui.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" Tapped="OnTapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="AccentBar" Grid.Column="0" />

        <StackPanel Grid.Column="1">
            <Image x:Name="Hero" Height="150" Stretch="UniformToFill" Visibility="Collapsed" />
            <Grid Padding="16,12,8,14" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{ThemeResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Top" Padding="6"
                        Background="Transparent" BorderThickness="0"
                        Tapped="OnCloseTapped" Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
